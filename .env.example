# Names only. Put values in the host secret store, never in git.
# Migration does not enable trading. LIVE is not an authority.
TRADING_MODE=disabled

# Paper arm. See deploy/paper.env.example.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# TYPESAFE_API_KEY=
# ATHENA_SYMBOL=
# ATHENA_FEED=iex
# ATHENA_SHARED_RISK_DIR=/var/lib/athena-risk
# ATHENA_EARNINGS_STATE_DIR=/var/lib/athena-earnings

# Earnings arm. See deploy/earnings.env.example.
# ATHENA_EARNINGS_UNIVERSE=/var/lib/athena-earnings/universe_75.txt
# Caps and the same-session hold stay at the code defaults unless an operator tightens them.
