# Store the real file at /etc/athena/earnings.env with mode 0600, owned by root.
# Supply keys through the deployment's secure secret setup; never commit them.
# This file is separate from /etc/athena/paper.env. The two services may use the
# same Alpaca paper key. They must not share a journal directory.
ALPACA_API_KEY=
ALPACA_API_SECRET=
TYPESAFE_API_KEY=
# Screener output, one ticker per line, at most 75 names. Not a secret.
# Produce it with research/earnings-universe/universe_screener.py and copy the file here.
ATHENA_EARNINGS_UNIVERSE=/var/lib/athena-earnings/universe_75.txt
ATHENA_FEED=iex
# Required for new entries. Both arms on one host must use this same absolute path.
ATHENA_SHARED_RISK_DIR=/var/lib/athena-risk
# Shared outcome store used by the intraday service. Closed earnings trades are
# written there with arm=earnings and are excluded from the intraday study.
# ATHENA_STATE_DIR=/var/lib/athena
# Symbol the intraday service trades. The earnings book will not enter it.
# ATHENA_SYMBOL=
# Optional tighter caps. Unset uses $50 per trade, $150 open risk, $2,000 / $6,000 notional,
# 3 positions, 1 new entry per day, same-session exits only. No overnight holdings.
# The 4% to 12% gap band is fixed and is not an environment setting.
# ATHENA_EARNINGS_PER_TRADE_RISK=50
# ATHENA_EARNINGS_TOTAL_RISK=150
# ATHENA_EARNINGS_MAX_NOTIONAL=2000
# ATHENA_EARNINGS_MAX_NOTIONAL_TOTAL=6000
# ATHENA_EARNINGS_MAX_POSITIONS=3
# ATHENA_EARNINGS_MAX_NEW_ENTRIES=1
# ATHENA_EARNINGS_MAX_HOLD_SESSIONS=1
# Legacy values 2..5 allow recovery only and disable new entries. Remove them or use 1.
# Same Jev gate as the intraday arm. Unset uses p(TAKE_TRADE) >= 0.6 and confidence >= 0.5.
# ATHENA_JEV_MIN_PTAKE=0.6
# ATHENA_JEV_MIN_CONFIDENCE=0.5
